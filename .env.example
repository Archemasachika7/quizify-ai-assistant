# ─────────────────────────────────────────────────────────────────────────────
# Quizify — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit the real .env to source control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────────────────────
# Find these in: Supabase Dashboard → Project Settings → API
# These two vars are used server-side (TanStack Start / SSR):
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<your-supabase-anon-key>

# Same values with VITE_ prefix — Vite exposes these to the browser bundle:
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<your-supabase-anon-key>
VITE_SUPABASE_PROJECT_ID=<your-project-ref>

# ── Google AI (Chatbots) ──────────────────────────────────────────────────────
# Used exclusively inside Supabase Edge Functions — NEVER exposed to the browser.
#
# Helper bot  → Gemma  3 27B IT     (gemma-3-27b-it)
# ClueBot     → Gemini Flash 2.5    (gemini-2.5-flash)
#
# Get a key at: https://aistudio.google.com/app/apikey
#
# Set as a Supabase Edge Function secret (not in .env):
#   supabase secrets set GOOGLE_AI_API_KEY=<key>
#
# For Vercel: add GOOGLE_AI_API_KEY in the Vercel dashboard under
#   Project → Settings → Environment Variables
GOOGLE_AI_API_KEY=<your-google-ai-api-key>

# ── Lovable AI Gateway (Quiz generation) ─────────────────────────────────────
# Used inside the generate-quiz Edge Function.
# Set as a Supabase secret:
#   supabase secrets set LOVABLE_API_KEY=<key>
LOVABLE_API_KEY=<your-lovable-api-key>

# ─────────────────────────────────────────────────────────────────────────────
# Vercel deployment checklist
# ─────────────────────────────────────────────────────────────────────────────
# In Vercel → Project → Settings → Environment Variables, add:
#   SUPABASE_URL
#   SUPABASE_PUBLISHABLE_KEY
#   VITE_SUPABASE_URL
#   VITE_SUPABASE_PUBLISHABLE_KEY
#   VITE_SUPABASE_PROJECT_ID
#
# GOOGLE_AI_API_KEY and LOVABLE_API_KEY are only needed inside Supabase Edge
# Functions (set via `supabase secrets set`), not in Vercel.
# ─────────────────────────────────────────────────────────────────────────────
